{
  "name": "journal-desktop",
  "productName": "Journal",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Terminal workspace with reviewed project knowledge for Claude Code and Codex",
  "main": "src/desktop/main.mjs",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "playwright test",
    "smoke:agents": "node scripts/native-smoke.mjs",
    "pilot:memory": "node scripts/memory-pilot.mjs",
    "check": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty",
    "trial:usefulness": "node scripts/usefulness-trial.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
