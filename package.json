{
  "name": "journal-desktop",
  "productName": "Journal",
  "version": "0.1.3",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "description": "Terminal workspace with reviewed project knowledge for Claude Code and Codex",
  "main": "src/desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "vite build",
    "build:profile": "vite build --mode profile",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "playwright test",
    "smoke:agents": "node scripts/native-smoke.mjs",
    "pilot:memory": "node scripts/memory-pilot.mjs",
    "check": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty",
    "trial:usefulness": "node scripts/usefulness-trial.mjs",
    "dist": "npm run build && npm run notices && electron-builder --config electron-builder.config.cjs --publish never",
    "dist:dir": "npm run build && npm run notices && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "data:restore": "node scripts/data-restore.mjs",
    "notices": "node scripts/notices.mjs",
    "dist:mac": "npm run build && npm run notices && electron-builder --config electron-builder.config.cjs --mac --arm64 --publish never",
    "dist:win": "npm run build && npm run notices && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "release:check": "node scripts/release-check.mjs",
    "release:checksums": "node scripts/checksums.mjs",
    "release:audit": "node scripts/package-audit.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron/rebuild": "4.2.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "author": "Adir Zak",
  "homepage": "https://github.com/adirz101/Journal",
  "repository": {
    "type": "git",
    "url": "https://github.com/adirz101/Journal.git"
  },
  "journal": {
    "rendererBundle": [
      "@codemirror/commands",
      "@codemirror/lang-javascript",
      "@codemirror/lang-json",
      "@codemirror/lang-markdown",
      "@codemirror/lang-python",
      "@codemirror/lang-yaml",
      "@codemirror/language",
      "@codemirror/legacy-modes",
      "@codemirror/search",
      "@codemirror/state",
      "@codemirror/view",
      "@fontsource/jetbrains-mono",
      "@headless-tree/core",
      "@headless-tree/react",
      "@lezer/highlight",
      "@xterm/addon-fit",
      "@xterm/addon-unicode11",
      "@xterm/xterm",
      "react",
      "react-dom"
    ]
  }
}
